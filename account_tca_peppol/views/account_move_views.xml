<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════════
         INVOICE FORM: TCA status, buttons, and UAE-specific fields
         ══════════════════════════════════════════════════════════════════════ -->
    <record id="view_move_form_tca_status" model="ir.ui.view">
        <field name="name">account.move.form.tca.peppol</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Hidden fields for visibility conditions (declared once) -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="tca_invoice_uuid" invisible="1"/>
                <field name="tca_submission_error" invisible="1"/>
                <field name="tca_is_inbound" invisible="1"/>
                <field name="tca_inbound_status" invisible="1"/>
                <field name="tca_show_credit_note_fields" invisible="1"/>
                <field name="tca_is_export" invisible="1"/>
                <field name="tca_buyer_is_uae" invisible="1"/>
                <field name="tca_is_self_billing" invisible="1"/>

                <!-- Retry button: outbound error/rejected only -->
                <button name="action_tca_resend"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-refresh"
                        invisible="tca_move_state not in ('error', 'rejected') or tca_is_inbound or move_type not in ('out_invoice', 'out_refund')">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Retry TCA</span>
                    </div>
                </button>

                <!-- Status badge: shown once submitted -->
                <button class="oe_stat_button" icon="fa-paper-plane"
                        invisible="tca_move_state == 'not_sent' or not tca_invoice_uuid">
                    <field name="tca_move_state" widget="badge"
                           decoration-success="tca_move_state in ('delivered', 'buyer_confirmed', 'inbound_received')"
                           decoration-warning="tca_move_state in ('submitted', 'processing', 'uploading')"
                           decoration-danger="tca_move_state in ('error', 'rejected', 'cancelled')"
                           string="TCA Status"/>
                </button>
            </xpath>

            <!-- ── Header buttons: Accept/Reject for inbound invoices ──── -->
            <!-- Per-document e-invoicing opt-out, placed in the header beside the
                 Confirm button (gap + light-purple pill matching the Draft
                 statusbar). Default ON. Off → PINT AE fields/checks/submit are
                 all suppressed for this move (see model gating). Shown only for
                 documents WE issue (out_* / self-bill) under an active TCA
                 company; readonly once posted. -->
            <!-- Two action_post buttons exist (hidden "Post" for entries, then
                 the visible "Confirm" for invoices). Anchor after the 2nd one
                 (Confirm) so the toggle renders to its right. `string` cannot be
                 used as an inheritance selector, so match by position. -->
            <xpath expr="//header/button[@name='action_post'][2]" position="after">
                <div class="o_tca_einvoice_header d-inline-flex align-items-center gap-2"
                     invisible="not tca_company_is_active or tca_is_inbound or (move_type not in ('out_invoice', 'out_refund') and not tca_is_self_billing)">
                    <field name="tca_create_einvoice" widget="boolean_toggle" nolabel="1"
                           readonly="state != 'draft'"/>
                    <span>Create E-Invoice (UAE)</span>
                </div>
            </xpath>

            <xpath expr="//header" position="inside">
                <button name="action_tca_accept_inbound"
                        string="Accept &amp; Post"
                        type="object"
                        class="btn-success"
                        invisible="not tca_is_inbound or tca_inbound_status != 'pending' or state != 'draft'"
                        data-hotkey="shift+a"/>
                <button name="action_tca_reject_inbound"
                        string="Reject"
                        type="object"
                        class="btn-danger"
                        invisible="not tca_is_inbound or tca_inbound_status != 'pending' or state != 'draft'"
                        data-hotkey="shift+r"/>
            </xpath>

            <!-- ── UAE compliance: hide native "Credit Note" button on plain
                 vendor bills. Per UAE FTA law, only the seller can issue a
                 credit note — the buyer cannot reverse a received vendor bill.
                 Exception: self-billed vendor bills (the buyer IS the issuer
                 on the supplier's behalf, UC4/UC5) keep the button so the
                 user can issue a self-billing credit note (381_sb). -->
            <xpath expr="//button[@name='action_reverse']" position="attributes">
                <attribute name="invisible">move_type not in ('out_invoice', 'in_invoice') or state != 'posted' or (tca_company_is_active and move_type == 'in_invoice' and not tca_is_self_billing)</attribute>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="tca_company_is_active" invisible="1"/>
            </xpath>

            <!-- ── UAE compliance: lock invoice currency to AED on outbound.
                 PINT AE mandate denominates customer invoices/credit-notes in
                 AED. _compute_currency_id in models/account_move.py forces the
                 value; this readonly attribute prevents the user from changing
                 it on the form. Inbound vendor bills keep their sender-supplied
                 currency. The currency-rate widget alongside is still useful
                 when the company currency isn't AED. -->
            <xpath expr="//div[@name='currency_div']//field[@name='currency_id'][1]" position="attributes">
                <attribute name="readonly">state != 'draft' or (tca_company_is_active and (move_type in ('out_invoice', 'out_refund') or tca_is_self_billing))</attribute>
            </xpath>

            <!-- ── Inbound status banner ───────────────────────────────── -->
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <div invisible="not tca_is_inbound" class="alert alert-info mb-0" role="alert">
                    <strong>TCA Peppol Inbound Invoice</strong> —
                    Status: <field name="tca_inbound_status" readonly="1" widget="badge"
                                   decoration-success="tca_inbound_status == 'accepted'"
                                   decoration-danger="tca_inbound_status == 'rejected'"
                                   decoration-warning="tca_inbound_status == 'pending'"/>
                    <span invisible="tca_inbound_status != 'rejected'" class="ms-2 text-danger">
                        Reason: <field name="tca_reject_reason" readonly="1" class="d-inline"/>
                    </span>
                </div>

                <!-- Outbound error banner -->
                <div invisible="not tca_submission_error or tca_is_inbound"
                     class="alert alert-danger mb-0" role="alert">
                    <strong>TCA Submission Error:</strong>
                    <field name="tca_submission_error" readonly="1" class="d-inline"/>
                </div>
            </xpath>

            <!-- ── UAE PINT AE fields — inline below customer details ─── -->
            <xpath expr="//notebook[page[@id='invoice_tab']]" position="before">
                <group col="1" invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')">
                    <!-- Three equal columns using the full form width (33% each).
                         Each col-md-4 is tagged `o_tca_pint_col`; SCSS in
                         static/src/scss/account_move_form.scss sets a fixed 160px label
                         column inside these sections so input cells always have
                         ≥200px (visible 10-digit IDs, emirate codes, etc.). -->
                    <!-- The Create E-Invoice toggle lives in the header (beside
                         Confirm). Declared invisible here too so the field is
                         loaded for the `parent.tca_create_einvoice` line domains
                         and the invisible conditions below. -->
                    <field name="tca_create_einvoice" invisible="1"/>
                    <div class="row g-4 mb-3 o_tca_pint_row"
                         invisible="not tca_create_einvoice or (move_type in ('in_invoice', 'in_refund') and not tca_is_self_billing)">
                        <div class="col-12 col-xxl o_tca_pint_col">
                            <group string="Invoice &amp; Buyer">
                                <!-- TCA fields are not view-level required: drafts can be saved
                                     and the user can navigate internal links freely.
                                     Mandatory-field enforcement runs at Confirm time via
                                     _tca_validate_mandatory_fields() in account_move._post(). -->
                                <!-- Invoice type code (380/381/480/81) is auto-set by the
                                     (move_type, tca_is_out_of_scope) compute. Hidden — the
                                     user toggles tca_is_out_of_scope below to switch between
                                     Tax Invoice and Commercial Invoice. The field itself is
                                     still read by the XML builder. -->
                                <field name="tca_invoice_type_code" invisible="1"/>
                                <!-- OOS toggle is meaningless for self-bills
                                     (no 480_sb variant in PINT AE — self-bill
                                     wins). Hide on self-bill rather than
                                     show-but-disabled. -->
                                <field name="tca_is_out_of_scope"
                                       invisible="tca_is_self_billing"
                                       readonly="move_type in ('in_invoice', 'in_refund') or reversed_entry_id"/>
                                <field name="tca_buyer_reference" string="Buyer Reference"
                                       placeholder="e.g. PO-001/23"
                                       readonly="move_type in ('in_invoice', 'in_refund')"/>
                                <field name="tca_buyer_participant_id" string="Buyer Participant ID"
                                       readonly="move_type in ('in_invoice', 'in_refund') and not tca_is_self_billing"/>
                                <field name="tca_seller_participant_id" string="Seller Participant ID"
                                       readonly="move_type in ('in_invoice', 'in_refund') and not tca_is_self_billing"
                                       placeholder="Vendor's Peppol Endpoint or 10-digit fallback"/>
                                <field name="tca_buyer_emirate"
                                       invisible="not tca_buyer_is_uae"
                                       readonly="move_type in ('in_invoice', 'in_refund')"/>
                                <field name="tca_credit_note_reason" string="Credit Note Reason"
                                       invisible="not tca_show_credit_note_fields"/>
                                <!-- IBT-081 Payment Means Code — hidden on
                                     credit notes (PaymentMeans suppressed),
                                     optional for Deemed Supply, required
                                     otherwise (ibr-191-ae). -->
                                <!-- Not view-level required: like the other TCA
                                     fields, drafts save freely and the ibr-191-ae
                                     check runs at Confirm (via
                                     _tca_collect_validation_errors), gated on the
                                     Create E-Invoice toggle. -->
                                <field name="tca_payment_means_code"
                                       string="Payment Means Code"
                                       invisible="move_type in ('out_refund', 'in_refund')"
                                       placeholder="Required — select payment method"/>
                                <!-- ibr-142-ae: Delivery address (Street, City,
                                     State) is mandatory when the E-commerce
                                     flag is set. The three fields auto-fill
                                     from the shipping party on toggle and
                                     clear on untick. -->
                                <field name="tca_delivery_street"
                                       string="Delivery Street"
                                       invisible="not tca_flag_ecommerce"/>
                                <field name="tca_delivery_city"
                                       string="Delivery City"
                                       invisible="not tca_flag_ecommerce"/>
                                <field name="tca_delivery_state_id"
                                       string="Delivery State / Emirate"
                                       invisible="not tca_flag_ecommerce"
                                       options="{'no_create': True, 'no_open': True}"/>
                            </group>
                        </div>
                        <div class="col-12 col-xxl o_tca_pint_col"
                             invisible="not tca_buyer_is_uae">
                            <group string="Buyer Legal">
                                <field name="tca_buyer_legal_id_type" string="Buyer Legal ID Type"
                                       readonly="move_type in ('in_invoice', 'in_refund')"/>
                                <field name="tca_buyer_trade_license" string="Buyer Trade License / Reg. ID"
                                       readonly="move_type in ('in_invoice', 'in_refund')"/>
                                <field name="tca_buyer_legal_authority" string="Buyer Issuing Authority"
                                       invisible="tca_buyer_legal_id_type != 'TL'"
                                       readonly="move_type in ('in_invoice', 'in_refund')"/>
                                <field name="tca_buyer_passport_country_id" string="Buyer Passport Country"
                                       invisible="tca_buyer_legal_id_type != 'PAS'"
                                       readonly="move_type in ('in_invoice', 'in_refund')"/>
                            </group>
                        </div>
                        <div class="col-12 col-xxl o_tca_pint_col">
                            <!-- Transaction Type (Optional) — collapsed by default.
                                 Toggle "Use Special Type" reveals 7 user-friendly checkboxes
                                 that compose the BTAE-02 string. Standard invoices: leave the
                                 toggle off (it auto-expands if any flag was set previously). -->
                            <group string="Transaction Type (Optional)">
                                <field name="tca_show_special_flags" widget="boolean_toggle"/>
                                <field name="tca_flag_free_trade_zone"
                                       invisible="not tca_show_special_flags"/>
                                <!-- ibr-007-ae: Beneficiary ID is
                                     mandatory when FTZ is ticked. Field is
                                     hidden otherwise; cleared by onchange on
                                     untick. -->
                                <field name="tca_buyer_beneficiary_id"
                                       string="Beneficiary ID"
                                       invisible="not tca_show_special_flags or not tca_flag_free_trade_zone"
                                       placeholder="Required for Free Trade Zone"/>
                                <!-- ibr-157-ae: Deemed Supply, Margin Scheme and Summary
                                     Invoice are forbidden on OOS (480 / 81) documents.
                                     Hide them when the user has ticked "Out of Scope".
                                     An onchange on tca_is_out_of_scope also auto-clears
                                     any of these flags that were True so a hidden-but-set
                                     value cannot leak through to Confirm. -->
                                <field name="tca_flag_deemed_supply"
                                       invisible="not tca_show_special_flags or tca_is_out_of_scope"/>
                                <field name="tca_flag_margin_scheme"
                                       invisible="not tca_show_special_flags or tca_is_out_of_scope"/>
                                <field name="tca_flag_summary_invoice"
                                       invisible="not tca_show_special_flags or tca_is_out_of_scope"/>
                                <field name="tca_flag_continuous_supply"
                                       invisible="not tca_show_special_flags"/>
                                <field name="tca_flag_disclosed_agent"
                                       invisible="not tca_show_special_flags"/>
                                <field name="tca_flag_ecommerce"
                                       invisible="not tca_show_special_flags"/>
                                <!-- Raw BTAE-02 string kept invisible — computed from the
                                     booleans above. Read by the XML builder. -->
                                <field name="tca_transaction_type_flags" invisible="1"/>
                            </group>
                        </div>
                    </div>
                    <!-- Additional Details — its own row below the 3-col row, only visible when special flags ask for it. -->
                    <group string="Additional Details"
                           invisible="not tca_create_einvoice or move_type in ('in_invoice', 'in_refund') or (not tca_flag_disclosed_agent and not tca_flag_continuous_supply and not tca_flag_summary_invoice and not tca_is_export)"
                           class="mt-3">
                        <field name="tca_principal_id" string="Principal TRN"
                               invisible="not tca_flag_disclosed_agent"/>
                        <field name="tca_contract_reference" string="Contract Reference"
                               invisible="not tca_flag_continuous_supply"
                               placeholder="e.g. framework-1"/>
                        <field name="tca_invoice_period_start" string="Invoice Period Start"
                               invisible="not tca_flag_summary_invoice and not tca_flag_continuous_supply"/>
                        <field name="tca_invoice_period_end" string="Invoice Period End"
                               invisible="not tca_flag_summary_invoice and not tca_flag_continuous_supply"/>
                        <field name="tca_billing_frequency" string="Billing Frequency"
                               invisible="not tca_flag_continuous_supply"/>
                        <field name="tca_export_declaration_number" string="Export Declaration No."
                               invisible="not tca_is_export"
                               placeholder="e.g. EXP-2026-001"/>
                    </group>
                    <!-- Inbound only: read-only display of optional fields the seller populated.
                         Each field hides when empty to keep the panel clean. -->
                    <group string="Additional Information (from seller)"
                           invisible="move_type not in ('in_invoice', 'in_refund')">
                        <group class="pe-md-5">
                            <field name="tca_buyer_accounting_ref" string="Buyer Accounting Ref" readonly="1"
                                   invisible="not tca_buyer_accounting_ref"/>
                            <field name="tca_project_reference" string="Project Reference" readonly="1"
                                   invisible="not tca_project_reference"/>
                            <field name="tca_contract_reference" string="Contract Reference" readonly="1"
                                   invisible="not tca_contract_reference"/>
                            <field name="tca_contract_value" string="Contract Value" readonly="1"
                                   invisible="not tca_contract_value"/>
                            <field name="tca_billing_frequency" string="Billing Frequency" readonly="1"
                                   invisible="not tca_billing_frequency"/>
                            <field name="tca_incoterms" string="Incoterms" readonly="1"
                                   invisible="not tca_incoterms"/>
                            <field name="tca_principal_id" string="Principal TRN" readonly="1"
                                   invisible="not tca_principal_id"/>
                        </group>
                        <group>
                            <field name="tca_tax_point_date" string="Tax Point Date" readonly="1"
                                   invisible="not tca_tax_point_date"/>
                            <field name="tca_delivery_date" string="Delivery Date" readonly="1"
                                   invisible="not tca_delivery_date"/>
                            <field name="tca_invoice_period_start" string="Invoice Period Start" readonly="1"
                                   invisible="not tca_invoice_period_start"/>
                            <field name="tca_invoice_period_end" string="Invoice Period End" readonly="1"
                                   invisible="not tca_invoice_period_end"/>
                            <field name="tca_delivery_party_trn" string="Deliver-to Party TRN" readonly="1"
                                   invisible="not tca_delivery_party_trn"/>
                            <field name="tca_export_declaration_number" string="Export Declaration No." readonly="1"
                                   invisible="not tca_export_declaration_number"/>
                        </group>
                    </group>
                </group>
            </xpath>

            <!-- ── Invoice line columns: UAE fields ────────────────────── -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="after">
                <field name="tca_commodity_type" optional="show" string="Commodity (UAE)" column_invisible="not parent.tca_create_einvoice"/>
                <field name="tca_hs_code" optional="show" string="HS Code" column_invisible="not parent.tca_create_einvoice"/>
                <field name="tca_service_accounting_code" optional="hide" string="SAC" column_invisible="not parent.tca_create_einvoice"/>
                <field name="tca_standard_item_id" optional="hide" string="GTIN / Standard ID" column_invisible="not parent.tca_create_einvoice"/>
                <field name="tca_rc_description" optional="hide" string="RC Description" column_invisible="not parent.tca_create_einvoice"/>
            </xpath>

            <!-- PINT AE requires Unit of Measure (IBT-130) on every line.
                 Upstream hides product_uom_id by default — force-show it. -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_uom_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>

            <!-- ── UAE compliance: restrict invoice tax picker to the six
                 PINT AE-tagged taxes (S/E/O/AE/Z/N) when company is TCA-active.
                 The l10n_ae per-emirate 5% taxes carry no tca_tax_category and
                 are hidden from the picker — they remain in the DB so they
                 don't break references on existing posted moves.
                 Domain mirrors upstream account/views/account_move_views.xml
                 (line list + line modal); update if upstream changes. -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='tax_ids']" position="attributes">
                <attribute name="domain">[('type_tax_use', '=?', parent.invoice_filter_type_domain), ('company_id', 'parent_of', parent.company_id), ('country_id', '=', parent.tax_country_id)] + ([('tca_tax_category', '!=', False)] if parent.tca_company_is_active and parent.tca_create_einvoice else [])</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='tax_ids']" position="attributes">
                <attribute name="domain">[('type_tax_use', '=?', parent.invoice_filter_type_domain), ('company_id', 'parent_of', parent.company_id), ('country_id', '=', parent.tax_country_id)] + ([('tca_tax_category', '!=', False)] if parent.tca_company_is_active and parent.tca_create_einvoice else [])</attribute>
            </xpath>

        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         LIST VIEW: TCA status column
         ══════════════════════════════════════════════════════════════════════ -->
    <record id="view_account_move_list_tca" model="ir.ui.view">
        <field name="name">account.move.list.tca.status</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="tca_move_state" optional="hide" string="TCA Status"
                       widget="badge"
                       decoration-success="tca_move_state in ('delivered', 'buyer_confirmed', 'inbound_received')"
                       decoration-warning="tca_move_state in ('submitted', 'processing', 'uploading')"
                       decoration-danger="tca_move_state in ('error', 'rejected', 'cancelled')"
                       decoration-muted="tca_move_state == 'not_sent'"/>
            </xpath>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         SEARCH FILTERS: TCA status filters
         ══════════════════════════════════════════════════════════════════════ -->
    <record id="view_account_move_filter_tca" model="ir.ui.view">
        <field name="name">account.move.filter.tca.peppol</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='draft']" position="after">
                <separator/>
                <filter string="TCA: Submitted" name="tca_submitted"
                        domain="[('tca_move_state', 'in', ['submitted', 'processing'])]"/>
                <filter string="TCA: Delivered" name="tca_delivered"
                        domain="[('tca_move_state', 'in', ['delivered', 'buyer_confirmed'])]"/>
                <filter string="TCA: Error / Rejected" name="tca_error"
                        domain="[('tca_move_state', 'in', ['error', 'rejected'])]"/>
                <filter string="TCA: Inbound" name="tca_inbound"
                        domain="[('tca_is_inbound', '=', True)]"/>
                <filter string="TCA: Inbound Pending" name="tca_inbound_pending"
                        domain="[('tca_is_inbound', '=', True), ('tca_inbound_status', '=', 'pending')]"/>
            </xpath>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         SEND & PRINT WIZARD: TCA checkbox

         Odoo 19 migration: the Send & Print wizard was rewritten. The old
         account.move.send form view (account.account_move_send_form) and its
         per-EDI checkbox fields no longer exist — the new account.move.send.wizard
         renders additional EDIs from a JSON `extra_edis` registry. The TCA send
         option will be re-added via that registry; no inherited view record is
         needed here. (Previous record: view_account_move_send_form_tca — removed.)
         ══════════════════════════════════════════════════════════════════════ -->

    <!-- ══════════════════════════════════════════════════════════════════════
         REJECT WIZARD FORM
         ══════════════════════════════════════════════════════════════════════ -->
    <record id="tca_inbound_reject_wizard_form" model="ir.ui.view">
        <field name="name">tca.inbound.reject.wizard.form</field>
        <field name="model">tca.inbound.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Inbound Invoice">
                <group>
                    <field name="move_id" readonly="1"/>
                    <field name="reason" widget="text"
                           placeholder="Enter the reason for rejecting this invoice..."/>
                </group>
                <footer>
                    <button name="action_reject" string="Reject Invoice"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         REVERSAL WIZARD overrides for TCA-active companies:
           1. Add the PINT AE BTAE-03 reason picker (required — sets
              tca_credit_note_reason on the new credit note).
           2. Hide "Reverse and Create Invoice" — Odoo's standard behavior for
              that button creates BOTH a credit note AND a replacement
              invoice draft. The replacement is unwanted noise in the UAE
              e-invoicing flow; users only want the credit note (which is
              then atomically posted + submitted to TCA on Confirm).
              The plain "Reverse" button remains visible.
         ══════════════════════════════════════════════════════════════════════ -->
    <record id="view_account_move_reversal_tca" model="ir.ui.view">
        <field name="name">account.move.reversal.form.tca</field>
        <field name="model">account.move.reversal</field>
        <field name="inherit_id" ref="account.view_account_move_reversal"/>
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="tca_company_is_active" invisible="1"/>
                <field name="tca_credit_note_reason"
                       invisible="not tca_company_is_active or move_type == 'entry'"
                       required="tca_company_is_active and move_type != 'entry'"/>
            </field>
            <xpath expr="//footer/button[@name='modify_moves']" position="attributes">
                <attribute name="invisible">tca_company_is_active or move_type == 'entry'</attribute>
            </xpath>
        </field>
    </record>

</odoo>
