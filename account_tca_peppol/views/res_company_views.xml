<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add an "Invoicing" tab to the company form carrying the PINT AE
         identity fields (related to the company partner), so a company can be
         configured for UAE e-invoicing without switching to the Contacts app. -->
    <record id="view_company_form_tca" model="ir.ui.view">
        <field name="name">res.company.form.tca.peppol</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='general_info']" position="after">
                <page string="Invoicing" name="tca_invoicing">
                    <group>
                        <group string="UAE Peppol Identity">
                            <field name="peppol_eas" string="Peppol EAS"/>
                            <field name="peppol_endpoint" string="Peppol Endpoint"/>
                            <field name="tca_emirate" string="Emirate"/>
                        </group>
                        <group string="UAE Legal Registration">
                            <field name="tca_legal_id_type" string="Legal ID Type"/>
                            <field name="tca_trade_license" string="Trade License / Registration ID"/>
                            <field name="tca_legal_authority" string="Issuing Authority"
                                   invisible="tca_legal_id_type != 'TL'"/>
                            <field name="tca_passport_country_id" string="Passport Issuing Country"
                                   invisible="tca_legal_id_type != 'PAS'"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
